# Separate config from program releases. Never commit real credentials.
CENTER_URL=http://10.10.0.10:8080
# Use the center's RELAY_API_KEY here, never its ADMIN_API_KEY.
CENTER_API_KEY=replace-center-key-with-at-least-24-characters
DEVICE_API_KEY=replace-device-key-with-at-least-24-characters
LOCAL_ADMIN_API_KEY=replace-local-admin-key-with-at-least-24-characters
RELAY_ID=workshop-1
RELAY_HOST=0.0.0.0
RELAY_PORT=18081
RELAY_DATA_DIR=C:/ProgramData/AP-ESOP/relay-data
POLL_SECONDS=10
CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=180
DOWNLOAD_RETRIES=3
RETRY_MAX_SECONDS=60
DISK_RESERVE_MB=512
CACHE_RETENTION_HOURS=24
MAX_FILE_MB=2048
MAX_JSON_MB=32
MAX_OUTBOX_EVENTS=100000
MAX_LOCAL_DOWNLOADS=4
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# Copy to .env and replace both keys with DIFFERENT random values (>=24 chars).
ADMIN_API_KEY=replace-admin-with-a-long-random-secret
RELAY_API_KEY=replace-relay-with-another-random-secret
RELAY_ID=workshop-1
# Synology local volume; do NOT use SMB/NFS for SQLite. Precreate and grant uid 10001 rw.
ESOP_DATA_DIR=/volume1/docker/esop/data
ESOP_BIND_IP=0.0.0.0
ESOP_PORT=8080
HEARTBEAT_SECONDS=10
OFFLINE_SECONDS=40
# Excel, PDF and image upload limit; PDF/Excel share the same persistent worker queue.
UPLOAD_MAX_MB=100
VIDEO_MAX_MB=200
VIDEO_MAX_SECONDS=180
CONVERSION_TIMEOUT_SECONDS=120
# Maximum PDF pages (including PDFs produced from Excel).
MAX_PAGES=200
PAGE_WARNING_COUNT=30
RENDER_DPI=160
# Browser account session duration. Enable Secure cookies behind HTTPS.
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
# For HTTPS reverse proxy: set its actual trusted source IP, not arbitrary clients.
FORWARDED_ALLOW_IPS=127.0.0.1
